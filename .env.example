# Copy to `.env` and adjust. Every value is optional; the defaults are shown.
# twinlens reads `.env` from the current directory, then real environment
# variables (which win), then CLI flags (which win over both).

# Max Hamming distance (0-64) between perceptual hashes to call two photos twins.
# 0 = only pixel-identical, 6 = strict, 10 = balanced, 14 = aggressive.
TWINLENS_THRESHOLD=10

# Hashing worker processes. 0 = one per CPU core.
TWINLENS_WORKERS=0

# SQLite file that remembers hashes between runs (keyed by path + size + mtime).
TWINLENS_CACHE=.twinlens/cache.sqlite

# Where `twinlens scan` writes the interactive report and the default plan.
TWINLENS_REPORT_DIR=twinlens-report

# Where `twinlens apply` moves removed photos (nothing is ever deleted).
TWINLENS_QUARANTINE=twinlens-quarantine

# Longest edge, in pixels, of the thumbnails embedded in the HTML report.
TWINLENS_THUMB_SIZE=320
